AIRFLOW_UID=50000

_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=changeme

# Blank is valid -- Airflow generates one at first boot if empty. Once this
# stack is used beyond a single throwaway run, set a real value and keep it:
# changing it later invalidates anything already encrypted with the old key.
AIRFLOW__CORE__FERNET_KEY=
