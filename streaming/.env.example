KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_UI_PORT=8089

# Reuses the store_db Postgres container (../store_db/docker-compose.yml) as the
# replay source — no separate database for streaming/.
POSTGRES_HOST=localhost
POSTGRES_PORT=5438
POSTGRES_DB=store_db
POSTGRES_USER=store_admin
POSTGRES_PASSWORD=changeme

# producers/replay.py __main__ defaults (the notebook calls publish_next() directly
# with explicit arguments instead — these only apply to `uv run producers/replay.py`)
REPLAY_LIMIT=
REPLAY_INTERVAL_SECONDS=0
REPLAY_BATCH_SIZE=1

# consumers/bronze_writer.py __main__ defaults (same — the notebook calls
# consume_batch() directly)
CONSUME_LIMIT=
CONSUME_IDLE_TIMEOUT_SECONDS=2
